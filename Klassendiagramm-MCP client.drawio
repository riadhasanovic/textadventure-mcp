classDiagram
    class OllamaClientModule {
        +BASE_URL : str
        +MODEL : str
        +SYSTEM_PROMPT : str
        +_PHONE_LISTEN_WORDS : frozenset
        +_PHONE_DELETE_WORDS : frozenset
        +_PHOTO_VIEW_WORDS : frozenset
        +_PHOTO_BURN_WORDS : frozenset
        +_PHONE_CHOICE_PROMPT : str
        +_PHOTO_CHOICE_PROMPT : str
        +ask_ollama(user_message: str, tools_description: str) : dict | None
        +format_result(tool_name: str, result: str) : str
        +classify_phone_choice(user_input: str) : str
        +classify_photo_choice(user_input: str) : str
        +_keyword_match(user_input: str, a_words: frozenset, b_words: frozenset) : str | None
        +_parse_tool_call(answer: str) : dict | None
    }

    class ToolCall {
        +tool : str
        +arguments : dict
    }

    class PhoneChoiceResponse {
        +choice : str
    }

    class PhotoChoiceResponse {
        +choice : str
    }

    class OllamaAPI {
        +url : str
        +model : str
        +messages : list
        +temperature : float
        +stream : bool
        +format : str
    }

    OllamaClientModule ..> ToolCall : erzeugt
    OllamaClientModule ..> PhoneChoiceResponse : nutzt (JSON)
    OllamaClientModule ..> PhotoChoiceResponse : nutzt (JSON)
    OllamaClientModule --> OllamaAPI : kommuniziert mit