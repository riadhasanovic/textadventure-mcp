classDiagram
    class MCPConnector {
        -session : ClientSession | None
        -tools_description : str
        -_tools_list : list
        +__init__() : None
        +connect() : AsyncContextManager
        +call_tool(tool_name: str, arguments: dict) : ToolResult
        +get_tools_description() : str
    }

    class ToolResult {
        <<dataclass>>
        +success : bool
        +output : str
        +error : str | None
    }

    class ClientSession {
        <<extern (mcp.client.session)>>
        +initialize() : None
        +list_tools() : ToolsList
        +call_tool(tool_name: str, arguments: dict) : ToolCallResult
    }

    class stdio_client {
        <<extern (mcp.client.stdio)>>
        +__aenter__() : tuple[read, write]
        +__aexit__() : None
    }

    class StdioServerParameters {
        <<extern (mcp.client.stdio)>>
        +command : str
        +args : list[str]
    }

    class Tool {
        <<extern (mcp.types)>>
        +name : str
        +description : str
    }

    class ToolCallResult {
        <<extern (mcp.types)>>
        +content : list[TextContent]
        +isError : bool
    }

    class TextContent {
        <<extern (mcp.types)>>
        +text : str
    }

    MCPConnector --> ToolResult : erzeugt
    MCPConnector --> ClientSession : verwendet
    MCPConnector --> stdio_client : verwendet (connect)
    MCPConnector --> StdioServerParameters : erzeugt
    MCPConnector --> Tool : speichert (_tools_list)
    
    ClientSession --> ToolCallResult : liefert (call_tool)
    ClientSession --> Tool : liefert (list_tools)
    
    ToolCallResult --> TextContent : enthält (content)