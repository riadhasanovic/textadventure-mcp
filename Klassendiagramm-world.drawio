classDiagram
    class Room {
        <<pydantic BaseModel>>
        +name : str
        +description : str
        +exits : Dict[str, str]
        +items : List[str]
        +model_config : ConfigDict
    }

    class WorldData {
        <<module-level constants>>
        +WORLD : Dict[str, Room]
        +ITEMS : Dict[str, str]
        +current_room : str
        +inventory : List[str]
    }

    class BaseModel {
        <<extern (pydantic)>>
        +model_config : ConfigDict
    }

    class ConfigDict {
        <<extern (pydantic)>>
        +validate_assignment : bool
        +frozen : bool
    }

    Room --|> BaseModel : erbt
    Room --> ConfigDict : verwendet (model_config)
    WorldData --> Room : enthält (WORLD)
    WorldData --> BaseModel : nutzt indirekt