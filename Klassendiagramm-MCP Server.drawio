classDiagram
    class MCPServer {
        <<FastMCP Instance>>
        +mcp : FastMCP
        +completed_tasks : set[str]
        +used_repair_tools : set[str]
        +triggered_manifestations : set[str]
        +garage_unlocked : bool
        +awaiting_phone_choice : bool
        +awaiting_photo_choice : bool
        +failed_tasks : set[str]
        +REPAIR_TOOLS : set[str]
        +REQUIRED_TASKS : set[str]
        +MANIFESTATIONS : dict[str, str]
        +_fog_manifestation(key: str) : str
        +look() : str
        +move(direction: str) : str
        +take(item: str) : str
        +inventory_tool() : str
        +use(item: str) : str
        +phone_listen() : str
        +phone_delete() : str
        +photo_view() : str
        +photo_burn() : str
        +glossar_tool() : str
    }

    class FastMCP {
        <<extern (mcp.server.fastmcp)>>
        +name : str
        +tool() : decorator
        +run(transport: str) : None
    }

    class World {
        <<module world.py>>
        +WORLD : dict[str, Room]
        +current_room : str
        +inventory : list[str]
        +ITEMS : dict[str, str]
    }

    class Room {
        +name : str
        +description : str
        +items : list[str]
        +exits : dict[str, str]
    }

    class Glossary {
        <<module glossary.py>>
        +discover(entity: str) : None
        +get_discovered() : list[dict]
    }

    class TaskSet {
        <<enumeration>>
        car_fixed
        friends_reconciled
        grandpa_forgiven
    }

    class RepairTools {
        <<enumeration>>
        wagenheber
        reifen_reparaturset
        radkreuz
    }

    class ManifestationKey {
        <<enumeration>>
        dnd_friends
        coach_ferguson
        opa_gerald
    }

    MCPServer --> FastMCP : ist eine Instanz von
    MCPServer --> World : importiert & nutzt
    MCPServer --> Glossary : importiert & nutzt
    MCPServer --> Room : verwendet (über World)
    MCPServer --> TaskSet : verwendet (completed_tasks/failed_tasks)
    MCPServer --> RepairTools : verwendet (REPAIR_TOOLS)
    MCPServer --> ManifestationKey : verwendet (MANIFESTATIONS)